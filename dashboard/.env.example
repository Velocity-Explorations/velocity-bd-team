# Copy to .env.local and fill in. Never commit .env.local and never print its values.

# The same ledger the pipeline writes, as in the repo's .env. Hosted (GKE, a container or a
# serverless host), use Supabase's pooler URL: the direct db.<ref>.supabase.co host has only an
# IPv6 address. Prepared statements are already off, so the transaction pooler (port 6543) works too.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Who may record decisions: comma-separated names. Add <email> after a name so a sign-in proxy
# (DASHBOARD_IAP_AUDIENCE or DASHBOARD_USER_HEADER) can name the person by email, and
# =<Slack user id> so older decisions made with Slack reactions show under that name too.
DASHBOARD_USERS=Jane Doe <jane@example.com>=U0123ABCD, John Roe

# Optional. Behind Google's Identity-Aware Proxy: the audience of the dashboard's backend service,
# /projects/<project number>/global/backendServices/<backend service id>. Every request except
# /healthz must then carry IAP's signed header, and the viewer is the email in it.
DASHBOARD_IAP_AUDIENCE=

# Optional. Behind another access proxy: the request header it sets with the person's name or
# email, used instead of the "Deciding as" picker.
DASHBOARD_USER_HEADER=

# Optional. "each" (the default, for the training phase): everyone decides every call, so a call
# stays in each person's review queue until they decide it. "shared": the first decision takes a
# call off everyone's queue.
DASHBOARD_QUEUE=each

# Time zone for displayed times. The ledger stores UTC.
DASHBOARD_TIMEZONE=America/Denver

# Optional. Where the pipeline writes run logs, for the log links on /runs. Default: ../data/logs
LEDGER_LOG_DIR=
