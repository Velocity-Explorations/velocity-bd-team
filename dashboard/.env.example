# Copy to .env.local and fill in. Never commit .env.local and never print its values.

# The same ledger the pipeline writes. Locally: the Supabase session pooler URL from the repo's .env.
# On a serverless host, use Supabase's transaction pooler (port 6543); prepared statements are already off.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Who may record decisions: comma-separated names. Add =<Slack user id> to a name so decisions
# made with Slack reactions (which store the Slack id) show under that name too.
DASHBOARD_USERS=Jane Doe=U0123ABCD, John Roe

# Optional. When set, the viewer is taken from this request header (set by an auth proxy in
# front of the dashboard) instead of the "Deciding as" picker.
DASHBOARD_USER_HEADER=

# Time zone for displayed times. The ledger stores UTC.
DASHBOARD_TIMEZONE=America/Denver

# Optional. Where the pipeline writes run logs, for the log links on /runs. Default: ../data/logs
LEDGER_LOG_DIR=
