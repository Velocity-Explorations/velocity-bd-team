# Copy to .env and fill in. Never commit .env. Never print or log these values.

# Ledger database. Hosted Postgres (Neon or Supabase) for the real thing:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SQLite for local work and tests:
DATABASE_URL=sqlite:///data/dev.db

# Vulcan SOF portal (Phase 2 logs in; Phase 1 only loads the page)
VULCAN_SOF_USERNAME=
VULCAN_SOF_PASSWORD=
VULCAN_OTP_MAILBOX=
# Only when the gog CLI is not installed: a Google app password for the OTP mailbox (IMAP)
VULCAN_OTP_IMAP_PASSWORD=

# Later phases
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
OLLAMA_URL=http://localhost:11434
