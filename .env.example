# Copy to .env and fill in. Never commit .env. Never print or log these values.

# Ledger database. Hosted Postgres (Neon or Supabase) for the real thing:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SQLite for local work and tests:
DATABASE_URL=sqlite:///data/dev.db

# Vulcan SOF portal (Phase 2 logs in; Phase 1 only loads the page)
VULCAN_SOF_USERNAME=
VULCAN_SOF_PASSWORD=
VULCAN_OTP_MAILBOX=
# Google app password for the Velocity mailbox, used over IMAP to read portal OTP emails when the gog CLI is absent
VELOCITY_GMAIL_APP_USERNAME=
VELOCITY_GMAIL_APP_PASSWORD=

# Later phases
ANTHROPIC_API_KEY=
# BD_SLACK_BOT_TOKEN is prefixed because a Windows user variable named SLACK_BOT_TOKEN exists on David's PC for another project
BD_SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional. The pipeline's own GitHub token for filing approved fault reports: a classic token with the repo
# scope. Without it they use whoever is signed in to gh. See "GitHub token" in docs/RUNBOOK.md.
BD_GITHUB_TOKEN=
# Optional. The second judge's xAI key: key velocity-bd-team on Velocity's xAI team, limited to grok-4.7.
# Without it only Claude judges. Not XAI_API_KEY: on David's PC that name holds another project's key.
BD_XAI_API_KEY=
# Optional. The model the Writer drafts with: a grok model (grok-4.7) uses BD_XAI_API_KEY; unset means
# claude-sonnet-5-5 on ANTHROPIC_API_KEY. The worker reads it when it starts, so restart it after a change.
WRITER_MODEL=
# SAM.gov's public API key (SAM.gov account profile, Account Details). One key, from an account with a
# role in Velocity's SAM.gov registration (1,000 requests a day; 10 without a role). Personal keys
# expire every 90 days. Not needed until the SAM.gov portal runs (portals/sam_gov/NOTES.md).
BD_SAM_API_KEY=
# Optional. The AI slop detection skill's scanner (scripts/slop_scan.py) for the drafting slop check.
# Unset means the skill's installed folder under ~/.claude/skills/ai-slop-detection.
AI_SLOP_SCAN=
# The BD Proposal Library folder on Drive (Library plan, Phase A on): the Register, the README, Submissions/.
LIBRARY_DRIVE_FOLDER_ID=
# The proposal workspace's Google service account: the full path to its JSON key file, kept on this PC
# outside the repo (docs/RUNBOOK.md, Google Drive and Sheets). Never paste the key's contents anywhere.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional. Where the dashboard is served once it is hosted; Slack cards and summaries then link to it.
DASHBOARD_URL=
# Optional. The team as in dashboard/.env.local, `Name=<Slack id>` comma separated; workspace notices mention people by it.
DASHBOARD_USERS=
# Workspace notices in Slack (step ready, behind target, the morning digest) post only when this is `on`.
WORKSPACE_SLACK=
OLLAMA_URL=http://localhost:11434
